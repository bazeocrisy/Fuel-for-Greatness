{
	// Fuel for Greatness — Cloudflare Worker + Static Assets
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fuel-for-greatness",
	"main": "worker.js",
	"compatibility_date": "2025-08-01",

	"assets": {
		// Serve the repo root as the static site, minus everything in .assetsignore
		"directory": "./",
		"binding": "ASSETS",

		// The Worker runs BEFORE static assets for API paths
		"run_worker_first": [
			"/api/*"
		]
	},

	// Cloudflare D1 — Fuel for Greatness family database
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fuel-for-greatness",
			"database_id": "cdea26fd-92b5-4f6a-9d9d-11fea7c06278",
			"remote": true
		}
	],

	"observability": {
		"enabled": true
	}
}